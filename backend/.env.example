# Copy to backend/.env for local development (backend/.env is git-ignored, so it never reaches GitHub).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sharkit
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# On Railway this is provided for you and takes priority over the DB_* values above:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Add your Netlify URL when deploying.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Set to 1 to see real error messages in API responses. Never in production.
APP_DEBUG=0
